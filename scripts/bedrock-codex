#!/usr/bin/env bash
# Launch Codex on Amazon Bedrock and keep the codex_prod credentials fresh.
# One self-contained script for macOS and Linux.
#
#   bedrock-codex [--mac|--linux] [astra|sol|luna]       refresh if needed, install the timer, launch Codex
#   bedrock-codex [--mac|--linux] --auth [--force]       refresh if needed and install the timer (run once)
#   bedrock-codex [--mac|--linux] --app [astra|sol|luna] refresh if needed, set the Codex app default model
#   bedrock-codex [--mac|--linux] --install-timer        install and start the 50-minute refresh timer
#   bedrock-codex -h|--help                              show this help
#
# --mac or --linux must come first and picks the platform; with neither, the platform
# is detected from `uname -s`. Passing both is an error.
#
# A timer re-runs `--auth --force` every 50 minutes, so the ~1-hour STS token in
# ~/.aws/credentials never lapses, overnight included:
#   Linux  a systemd user timer (codex-bedrock-refresh.timer; linger keeps it running)
#   macOS  a per-user LaunchAgent (com.hss.codex-bedrock-refresh)
# Codex's own credential_process (codex-bedrock-creds) also refreshes by running
# `bedrock-codex --auth` with CODEX_BEDROCK_FROM_CREDS=1, which skips the timer install.
#
# Written for bash 3.2 (the macOS system bash): no bash 4+ features, no GNU-only tools
# on the mac path.
set -euo pipefail

# Source profile macaw-auth writes (short-lived keys, ~1 h). Credentials are always
# checked and verified through this profile, never CODEX_PROFILE: codex_bedrock's
# credential_process calls this script, so verifying through it would recurse.
PROFILE="${CODEX_BEDROCK_PROFILE:-codex_prod}"
# Profile Codex uses: its credential_process (~/.local/bin/codex-bedrock-creds)
# re-reads codex_prod as keys near expiry, so a running Codex app never needs a restart.
CODEX_PROFILE="codex_bedrock"
CODEX_PROVIDER="amazon-bedrock-runtime"
REGION="us-east-1"
ENV_FILE="$HOME/.codex/.env"
CONFIG_FILE="$HOME/.codex/config.toml"
CREDENTIALS_FILE="${AWS_SHARED_CREDENTIALS_FILE:-$HOME/.aws/credentials}"
THRESHOLD="${CODEX_BEDROCK_REFRESH_THRESHOLD:-300}"
INTERVAL_SECS=3000
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/bedrock-codex-refresh-${UID}.lock"
TIMER="codex-bedrock-refresh.timer"
SERVICE="codex-bedrock-refresh.service"
# macOS only: mkdir lock directory (no flock there) and the LaunchAgent.
LOCK_DIR="${TMPDIR:-/tmp}"
LOCK_DIR="${LOCK_DIR%/}/bedrock-codex-refresh-${UID}.lock.d"
LOCK_STALE_MINS=5
LABEL="com.hss.codex-bedrock-refresh"
PLATFORM=""

# ── Platform ──────────────────────────────────────────────────
usage() {
    cat <<'EOF'
Usage: bedrock-codex [--mac|--linux] [astra|sol|luna]
       bedrock-codex [--mac|--linux] --auth [--force]
       bedrock-codex [--mac|--linux] --app [astra|sol|luna]
       bedrock-codex [--mac|--linux] --install-timer
       bedrock-codex -h|--help

  --mac, --linux   pick the platform (first argument); default: detect from uname -s
  astra|sol|luna   model to launch (astra or 6, sol, luna); omit to pick from a menu
  --auth           refresh codex_prod credentials if needed and install the timer;
                   --force refreshes regardless
  --app            set the Codex app default model; on macOS also restarts ChatGPT
                   (Codex Desktop), on Linux prints a reload hint
  --install-timer  install and start the 50-minute refresh timer
                   (systemd user timer on Linux, LaunchAgent on macOS)
  -h, --help       this help
EOF
}

# Resolve this script's own absolute path. readlink -f is missing on older macOS,
# so fall back to following symlinks by hand.
resolve_self() {
    local src="${BASH_SOURCE[0]}" dir
    if readlink -f "$src" 2>/dev/null; then return 0; fi
    while [[ -L "$src" ]]; do
        dir="$(cd -P "$(dirname "$src")" && pwd)"
        src="$(readlink "$src")"
        [[ "$src" == /* ]] || src="$dir/$src"
    done
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    printf '%s/%s\n' "$dir" "$(basename "$src")"
}

detect_platform() {
    [[ -z "$PLATFORM" ]] || return 0
    case "$(uname -s)" in
        Darwin) PLATFORM=mac ;;
        Linux)  PLATFORM=linux ;;
        *)      echo "Error: unsupported platform '$(uname -s)'; pass --mac or --linux." >&2
                exit 1 ;;
    esac
}

# ── Model resolution ──────────────────────────────────────────
resolve_model() {
    case "${1:-}" in
        astra|6) MODEL="global.openai.gpt-6-astra" ;;
        sol)      MODEL="global.openai.gpt-6-sol" ;;
        luna)     MODEL="global.openai.gpt-6-luna" ;;
        "")       pick_model; return ;;
        *)        echo "Unknown model: $1"
                  echo "Options: astra (or 6), sol, luna"
                  echo "Flags: -auth/--auth [--force], --app [astra|sol|luna], --install-timer"
                  exit 1 ;;
    esac
    echo "Using $MODEL"
}

pick_model() {
    local MODELS=(
        "global.openai.gpt-6-astra"
        "global.openai.gpt-6-luna"
        "global.openai.gpt-6-sol"
    )
    echo ""
    echo "Select a model:"
    for i in "${!MODELS[@]}"; do
        printf "  %d) %s\n" $((i + 1)) "${MODELS[$i]}"
    done
    echo ""
    read -rp "Enter number [1]: " choice
    choice="${choice:-1}"

    if [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#MODELS[@]} )); then
        MODEL="${MODELS[$((choice - 1))]}"
    else
        echo "Invalid selection. Defaulting to ${MODELS[0]}."
        MODEL="${MODELS[0]}"
    fi
    echo "Using $MODEL"
}

# Linux: only the default model changes.
configure_app_model() {
    local config_file="$1"
    local app_model="$2"

    if [[ ! -f "$config_file" ]]; then
        echo "Missing Codex config: $config_file" >&2
        exit 1
    fi

    MODEL_VALUE="$app_model" perl -0pi -e 's/^model = .*$/model = "$ENV{MODEL_VALUE}"/m' "$config_file"
}

# macOS: also pin the provider and rename the provider's .aws table header to match.
# Values reach perl through the environment, never interpolated into the perl code.
configure_desktop_model() {
    local config_file="$1"
    local desktop_model="$2"

    if [[ ! -f "$config_file" ]]; then
        echo "Missing Codex config: $config_file" >&2
        exit 1
    fi

    MODEL_VALUE="$desktop_model" PROVIDER_VALUE="$CODEX_PROVIDER" perl -0pi -e \
        's/^model = .*$/model = "$ENV{MODEL_VALUE}"/m;
         s/^model_provider = .*$/model_provider = "$ENV{PROVIDER_VALUE}"/m;
         s/^\[model_providers\.(?:amazon-bedrock|amazon-bedrock-runtime)\.aws\]$/[model_providers.$ENV{PROVIDER_VALUE}.aws]/m' \
        "$config_file"
}

# Codex Desktop is hosted inside ChatGPT.app; its codex app-server child loads
# ~/.codex/.env once at start. Only quitting ChatGPT replaces it.
restart_desktop_app() {
    echo "Restarting Codex Desktop in $REGION (ChatGPT.app host)..."

    osascript -e 'quit app "ChatGPT"' 2>/dev/null || true

    for _ in $(seq 1 20); do
        pgrep -f 'Resources/codex .*app-server' >/dev/null || break
        sleep 0.5
    done

    # Kill any leftover app-server if the host did not take it down
    pkill -f 'Resources/codex .*app-server' 2>/dev/null || true

    sleep 1

    open -a ChatGPT

    echo "Codex Desktop relaunched. Credentials now refresh in place; no further restarts needed."
}

# Stop with a clear message when a required command is missing.
need() {
    command -v "$1" >/dev/null 2>&1 || { echo "Error: '$1' not found on PATH. $2" >&2; exit 1; }
}

# ── Credentials ───────────────────────────────────────────────
# Seconds until the expiration macaw-auth wrote for $PROFILE (negative when past).
# Linux uses GNU date; macOS date has no --date, so python3 parses the timestamp.
seconds_remaining() {
    local exp exp_epoch
    exp="$(awk -v t="$PROFILE" '
        $0 == "[" t "]" { in_p = 1; next }
        /^\[/ { in_p = 0 }
        in_p && /^[[:space:]]*expiration[[:space:]]*=/ { sub(/^[^=]*=[[:space:]]*/, ""); print; exit }
    ' "$CREDENTIALS_FILE" 2>/dev/null)"
    [[ -n "$exp" ]] || return 1
    if [[ "$PLATFORM" == mac ]]; then
        python3 -I -c '
import sys
from datetime import datetime, timezone
s = sys.argv[1].strip()
if s[-1:] in ("Z", "z"):
    s = s[:-1] + "+00:00"
d = datetime.fromisoformat(s)
if d.tzinfo is None:
    d = d.replace(tzinfo=timezone.utc)
print(int((d - datetime.now(timezone.utc)).total_seconds()))
' "$exp" 2>/dev/null
    else
        exp_epoch="$(date --date="$exp" +%s 2>/dev/null)" || return 1
        echo $(( exp_epoch - $(date +%s) ))
    fi
}

# Written atomically so a Codex starting mid-refresh never reads an empty file.
write_env_file() {
    local tmp
    mkdir -p "$HOME/.codex"
    tmp="$(mktemp "$ENV_FILE.XXXXXX")"
    printf '%s\n' "AWS_PROFILE=$CODEX_PROFILE" "AWS_REGION=$REGION" "AWS_DEFAULT_REGION=$REGION" > "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$ENV_FILE"
}

# ── Lock ──────────────────────────────────────────────────────
# Linux: flock on fd 9. macOS has no flock, so an atomic mkdir is the lock: waiters
# poll, a holder cleans up on exit, and a lock directory older than LOCK_STALE_MINS
# (holder was SIGKILLed or lost power) is broken.
lock_acquire() {
    if [[ "$PLATFORM" != mac ]]; then
        exec 9>"$LOCK_FILE"
        flock 9
        return 0
    fi
    mkdir -p "$(dirname "$LOCK_DIR")"
    until mkdir "$LOCK_DIR" 2>/dev/null; do
        if [[ ! -d "$LOCK_DIR" ]]; then
            echo "Cannot create lock directory $LOCK_DIR." >&2
            exit 1
        fi
        if [[ -n "$(find "$LOCK_DIR" -maxdepth 0 -mmin "+$LOCK_STALE_MINS" 2>/dev/null)" ]]; then
            echo "Breaking stale lock $LOCK_DIR." >&2
            rmdir "$LOCK_DIR" 2>/dev/null || true
            continue
        fi
        sleep 0.2
    done
    trap lock_release EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM
}

lock_release() {
    if [[ "$PLATFORM" == mac ]]; then
        trap - EXIT INT TERM
        rmdir "$LOCK_DIR" 2>/dev/null || true
    else
        flock -u 9
    fi
}

# $1 = "force" skips the expiry check. The lock serialises the timer and manual
# runs; a waiter re-checks expiry once the lock frees.
refresh() {
    local rem
    [[ "$PLATFORM" != mac ]] || need python3 "macOS needs it to read the credential expiry (brew install python3, or xcode-select --install)."
    lock_acquire
    if [[ "${1:-}" != force ]] && rem="$(seconds_remaining)" && (( rem > THRESHOLD )); then
        echo "Profile $PROFILE valid for ${rem}s; refresh skipped." >&2
    else
        need macaw-auth "Install it first; it logs in and writes the keys to $CREDENTIALS_FILE."
        need aws "Install the AWS CLI."
        echo "Refreshing $PROFILE with macaw-auth..." >&2
        macaw-auth login "$PROFILE" --target-profile "$PROFILE" </dev/null
        echo "Verifying AWS credentials..." >&2
        AWS_PROFILE="$PROFILE" AWS_REGION="$REGION" aws sts get-caller-identity >/dev/null
        echo "AWS credentials are valid." >&2
    fi
    write_env_file
    lock_release
}

# ── Refresh timer ─────────────────────────────────────────────
install_timer_linux() {
    command -v systemctl >/dev/null 2>&1 || return 0
    if ! systemctl --user show-environment >/dev/null 2>&1; then
        echo "No systemd user manager; refresh timer not installed." >&2
        return 0
    fi
    if [[ "$(systemctl --user is-enabled "$TIMER" 2>/dev/null || true)" == enabled ]]; then
        return 0
    fi
    local dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user" exe="$SELF"
    # Quote the executable for systemd: escape backslashes, quotes, % and $.
    exe="${exe//\\/\\\\}"; exe="${exe//\"/\\\"}"; exe="${exe//%/%%}"; exe="${exe//\$/\$\$}"
    mkdir -p "$dir"
    printf '%s\n' '[Unit]' 'Description=Refresh Codex Bedrock credentials' \
        '' '[Service]' 'Type=oneshot' \
        'Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"' \
        "ExecStart=\"$exe\" --linux --auth --force" > "$dir/$SERVICE"
    printf '%s\n' '[Unit]' 'Description=Refresh Codex Bedrock credentials every 50 minutes' \
        '' '[Timer]' "Unit=$SERVICE" 'OnActiveSec=' "OnActiveSec=${INTERVAL_SECS}s" \
        "OnUnitActiveSec=${INTERVAL_SECS}s" 'AccuracySec=1s' 'RandomizedDelaySec=0' \
        '' '[Install]' 'WantedBy=timers.target' > "$dir/$TIMER"
    systemctl --user daemon-reload
    systemctl --user enable --now "$TIMER"
    echo "Installed and started $TIMER (every ${INTERVAL_SECS}s)." >&2
}

xml_escape() {
    printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# A loaded agent is left alone (like the Linux "already enabled" check); otherwise
# write the plist and bootstrap it into the user's GUI domain.
install_timer_mac() {
    if ! command -v launchctl >/dev/null 2>&1; then
        echo "launchctl not found; refresh timer not installed." >&2
        return 0
    fi
    local domain="gui/$(id -u)"
    if launchctl print "$domain/$LABEL" >/dev/null 2>&1; then
        return 0
    fi
    local plist="$HOME/Library/LaunchAgents/$LABEL.plist" logs="$HOME/.codex/logs" tmp
    local exe path_env out err
    exe="$(xml_escape "$SELF")"
    path_env="$(xml_escape "$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin")"
    out="$(xml_escape "$logs/bedrock-refresh-launchd.out.log")"
    err="$(xml_escape "$logs/bedrock-refresh-launchd.err.log")"
    mkdir -p "$HOME/Library/LaunchAgents" "$logs"
    tmp="$(mktemp "$plist.XXXXXX")"
    cat > "$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>$exe</string>
        <string>--mac</string>
        <string>--auth</string>
        <string>--force</string>
    </array>
    <key>StartInterval</key>
    <integer>$INTERVAL_SECS</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>$path_env</string>
    </dict>
    <key>StandardOutPath</key>
    <string>$out</string>
    <key>StandardErrorPath</key>
    <string>$err</string>
</dict>
</plist>
EOF
    mv -f "$tmp" "$plist"
    launchctl bootstrap "$domain" "$plist"
    echo "Installed and started $LABEL (every ${INTERVAL_SECS}s)." >&2
}

install_timer() {
    if [[ "$PLATFORM" == mac ]]; then install_timer_mac; else install_timer_linux; fi
}

# ── Main ──────────────────────────────────────────────────────
SELF="$(resolve_self)"
# Consume leading --mac/--linux; giving both is an error.
while [[ "${1:-}" == --mac || "${1:-}" == --linux ]]; do
    if [[ -n "$PLATFORM" && "$PLATFORM" != "${1#--}" ]]; then
        echo "Error: pass only one of --mac or --linux." >&2
        exit 1
    fi
    PLATFORM="${1#--}"
    shift
done

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac
detect_platform

unset AWS_BEARER_TOKEN_BEDROCK 2>/dev/null || true

case "${1:-}" in
    --auth|-auth)
        if [[ "${2:-}" == "--force" ]]; then refresh force; else refresh ""; fi
        # codex-bedrock-creds (credential_process) sets this; it must not install a timer.
        [[ "${CODEX_BEDROCK_FROM_CREDS:-}" == 1 ]] || install_timer
        echo "Authentication complete."
        exit 0
        ;;
    --install-timer)
        install_timer
        exit 0
        ;;
    --app)
        need perl "It edits $CONFIG_FILE."
        refresh ""
        install_timer
        resolve_model "${2:-astra}"
        if [[ "$PLATFORM" == mac ]]; then
            configure_desktop_model "$CONFIG_FILE" "$MODEL"
            restart_desktop_app
        else
            configure_app_model "$CONFIG_FILE" "$MODEL"
            echo "Codex app default set to $MODEL. Reload the Codex app session (Settings -> Connections -> Update) to apply it."
        fi
        exit 0
        ;;
esac

need codex "Install Codex first."
refresh ""
install_timer
resolve_model "${1:-}"

echo "Launching Codex..."
if [[ "$PLATFORM" == mac ]]; then
    exec env \
        -u AWS_BEARER_TOKEN_BEDROCK \
        -u OPENAI_API_KEY \
        -u AWS_ACCESS_KEY_ID \
        -u AWS_SECRET_ACCESS_KEY \
        -u AWS_SESSION_TOKEN \
        AWS_PROFILE="$CODEX_PROFILE" \
        AWS_REGION="$REGION" \
        AWS_DEFAULT_REGION="$REGION" \
        codex \
            -c "model_provider=\"$CODEX_PROVIDER\"" \
            -c "model_providers.$CODEX_PROVIDER.aws.profile=\"$CODEX_PROFILE\"" \
            -c "model_providers.$CODEX_PROVIDER.aws.region=\"$REGION\"" \
            --model "$MODEL"
fi
exec env \
    -u AWS_BEARER_TOKEN_BEDROCK \
    AWS_PROFILE="$CODEX_PROFILE" \
    AWS_REGION="$REGION" \
    AWS_DEFAULT_REGION="$REGION" \
    codex --model "$MODEL"
