---
title: "How bedrock-setup keeps Bedrock credentials fresh"
---
%% Pictures live in icons/ next to this file (bedrock and user from aws_icons.py; the rest drawn by hand).
%% Render: MMDC=<path to mmdc> python3 <architecture-diagram skill>/scripts/render.py docs/diagrams/credential-flow.mmd
flowchart TB
  subgraph TRIGGERS["1 · Something asks for a refresh"]
    direction LR
    you@{ img: "icons/user.svg", label: "You run a launcher", pos: "t", w: 64, h: 64, constraint: "on" }
    timer@{ img: "icons/clock.svg", label: "Refresh timer, 50 min<br/>systemd or LaunchAgent", pos: "t", w: 64, h: 64, constraint: "on" }
    ccrefresh@{ img: "icons/claude-code.svg", label: "Claude Code<br/>awsAuthRefresh setting", pos: "t", w: 64, h: 64, constraint: "on" }
    creds@{ img: "icons/gear-script.svg", label: "Codex credential_process<br/>codex-bedrock-creds", pos: "t", w: 64, h: 64, constraint: "on" }
    you ~~~ timer ~~~ ccrefresh ~~~ creds
  end

  subgraph LAUNCHERS["2 · Launchers, with --mac or --linux"]
    direction LR
    bclaude@{ img: "icons/terminal.svg", label: "bedrock-claude --auth", pos: "t", w: 64, h: 64, constraint: "on" }
    bcodex@{ img: "icons/terminal.svg", label: "bedrock-codex --auth", pos: "t", w: 64, h: 64, constraint: "on" }
    bclaude ~~~ bcodex
  end

  subgraph LOGIN["3 · Login, only when the keys are near expiry"]
    direction LR
    macaw@{ img: "icons/key.svg", label: "macaw-auth login", pos: "t", w: 64, h: 64, constraint: "on" }
    file@{ img: "icons/credentials.svg", label: "~/.aws/credentials<br/>claude_prod, codex_prod", pos: "t", w: 64, h: 64, constraint: "on" }
    macaw -- "writes 1-hour keys" --> file
  end

  subgraph USE["4 · Claude Code and Codex call Bedrock with the fresh keys"]
    direction LR
    claude@{ img: "icons/claude-code.svg", label: "Claude Code<br/>profile claude_prod", pos: "t", w: 64, h: 64, constraint: "on" }
    codex@{ img: "icons/codex.svg", label: "Codex<br/>profile codex_bedrock", pos: "t", w: 64, h: 64, constraint: "on" }
    bedrock@{ img: "icons/bedrock.svg", label: "Amazon Bedrock<br/>us-east-1", pos: "t", w: 64, h: 64, constraint: "on" }
    claude ~~~ codex ~~~ bedrock
  end

  TRIGGERS -- "run with --auth" --> LAUNCHERS
  LAUNCHERS -- "refresh, then verify" --> LOGIN
  LOGIN -. "fresh keys" .-> USE
